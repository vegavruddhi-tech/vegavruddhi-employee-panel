# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/CompanyDB

# JWT
JWT_SECRET=<your_jwt_secret_key>

# Google OAuth
GOOGLE_CLIENT_ID=<your_google_oauth_client_id>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your_cloudinary_cloud_name>
CLOUDINARY_API_KEY=<your_cloudinary_api_key>
CLOUDINARY_API_SECRET=<your_cloudinary_api_secret>

# Server
PORT=4000
NODE_ENV=development

# CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=https://team-leader-gamma.vercel.app,https://vegavruddhi-admin-panel.vercel.app,https://vegavruddhi-employee-panel.vercel.app
